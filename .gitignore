
# ==================================================
# QUEUELESS - GITIGNORE
# Proyecto de gestion de turnos virtuales
#
# Frontend: React + Vite
# Backend: Python + Django REST Framework
# Database: PostgreSQL
# Notifications: Firebase Cloud Messaging
# Operating System: Windows
# ==================================================


# ==================================================
# 1. PYTHON
# ==================================================

__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python

*.egg-info/
.eggs/
wheels/
build/
dist/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
htmlcov/


# ==================================================
# 2. ENTORNOS VIRTUALES
# ==================================================

.venv/
venv/
env/
ENV/
virtualenv/


# ==================================================
# 3. DJANGO
# ==================================================

*.log

local_settings.py

db.sqlite3
db.sqlite3-journal

staticfiles/
media/

# IMPORTANTE:
# NO ignorar las carpetas migrations.
# Las migraciones de Django SI deben subirse a GitHub.


